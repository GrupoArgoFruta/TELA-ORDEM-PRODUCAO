	<field name="PRODUTOR" class="java.lang.String"/>
	<field name="VALVULA" class="java.lang.String"/>
	<variable name="totalPallets" class="java.math.BigDecimal" resetType="Column" calculation="Sum">
		<variableExpression><![CDATA[$F{QTDPALLETS}]]></variableExpression>
	</variable>
	<variable name="totalCaixas" class="java.math.BigDecimal" resetType="Column" calculation="Sum">
		<variableExpression><![CDATA[($F{QTDPALLETS} == null ? java.math.BigDecimal.ZERO : $F{QTDPALLETS}).multiply($F{PADRAO} == null ? java.math.BigDecimal.ZERO : $F{PADRAO})]]></variableExpression>
	</variable>

<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="OrdemProducao" language="groovy" pageWidth="1000" pageHeight="595" orientation="Landscape" columnWidth="960" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20">
	<property name="ireport.zoom" value="2.0"/>
	<property name="ireport.x" value="0"/>
	<property name="ireport.y" value="0"/>
	<parameter name="PK_CODOP" class="java.math.BigDecimal" isForPrompting="false">
		<parameterDescription><![CDATA[Codigo da OP (AD_ORDEMPRODUCAO.CODOP) selecionada na tela]]></parameterDescription>
	</parameter>
	<queryString>
		<![CDATA[SELECT
    OP.CODOP,
    OP.MERCADO,
    OP.OBSERVACAO,
    OP.SEMANA,
    OP.NUMPEDIDOSEMANA,
    OP.NUNOTA,
    OP.DATACARREGAMENTO,
    PAR.NOMEPARC          AS CLIENTE,
    ITE.CODITEM,
    ITE.QTDPALLETS,
    ITE.DTEMBALAGEM,
    PRO.DESCRPROD          AS PRODUTO,
    MP.DESCRPROD           AS VARIEDADE,
    ITE.CALIBRE,
    ITE.PADRAO,
    CUMB.DESCRPROD          AS CUMBUCA,
    CETQ.DESCRPROD          AS CINTAETIQUETA,
    ITE.ETIQUETA,
    PARPROD.NOMEPARC       AS PRODUTOR,
    AREA.DESCVALVULA       AS VALVULA
FROM AD_ORDEMPRODUCAO OP
INNER JOIN AD_ORDEMPRODUCAOITEM ITE ON ITE.CODOP = OP.CODOP
LEFT JOIN TGFPAR PAR     ON PAR.CODPARC = OP.CODPARC
LEFT JOIN TGFPRO PRO     ON PRO.CODPROD = ITE.CODPROD
LEFT JOIN TGFPRO MP      ON MP.CODPROD = ITE.CODPRODMP
LEFT JOIN TGFPRO CUMB    ON CUMB.CODPROD = ITE.CODCUMBUCA
LEFT JOIN TGFPRO CETQ    ON CETQ.CODPROD = ITE.CODPRODAD
LEFT JOIN TGFPAR PARPROD ON PARPROD.CODPARC = ITE.CODPARC
LEFT JOIN AD_AREAPARC AREA ON AREA.CODPARC = ITE.CODPARC AND AREA.CODAREA = ITE.CODAREA
WHERE OP.CODOP = $P{PK_CODOP}
ORDER BY ITE.CODITEM]]>
	</queryString>
	<field name="CODOP" class="java.math.BigDecimal"/>
	<field name="MERCADO" class="java.lang.String"/>
	<field name="OBSERVACAO" class="java.lang.String"/>
	<field name="SEMANA" class="java.lang.String"/>
	<field name="NUMPEDIDOSEMANA" class="java.lang.String"/>
	<field name="NUNOTA" class="java.math.BigDecimal"/>
	<field name="DATACARREGAMENTO" class="java.util.Date"/>
	<field name="CLIENTE" class="java.lang.String"/>
	<field name="CODITEM" class="java.math.BigDecimal"/>
	<field name="QTDPALLETS" class="java.math.BigDecimal"/>
	<field name="DTEMBALAGEM" class="java.util.Date"/>
	<field name="PRODUTO" class="java.lang.String"/>
	<field name="VARIEDADE" class="java.lang.String"/>
